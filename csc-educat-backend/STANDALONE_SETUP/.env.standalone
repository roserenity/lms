APP_NAME="My LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Your public-facing URL (used in email links, certificate QR codes, etc.)
APP_URL=https://lms.mycompany.com

# Bare hostname (no protocol) — used as SCORM/payment callback base
APP_DOMAIN=lms.mycompany.com

# Short identifier for your organization.
# Used in: Passport token names, S3 storage paths, certificate QR codes.
# Keep it short, lowercase, no spaces. Example: "myorg", "acmecorp"
TENANT_ID=myorg

# Display name (used in emails and UI references)
TENANT_NAME="My Company LMS"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ──────────────────────────────────────────────────────
# DATABASE — Single connection (no central/replica split)
# ──────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_lms
DB_USERNAME=root
DB_PASSWORD=

# ──────────────────────────────────────────────────────
# CACHE / QUEUE / SESSION
# ──────────────────────────────────────────────────────
BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ──────────────────────────────────────────────────────
# REDIS
# ──────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ──────────────────────────────────────────────────────
# MAIL
# ──────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@mycompany.com"
MAIL_FROM_NAME="${TENANT_NAME}"

# ──────────────────────────────────────────────────────
# AWS S3 (file storage for uploads, certificates, exports)
# Set FILESYSTEM_DISK=local for development without S3
# ──────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_URL=

# ──────────────────────────────────────────────────────
# PUSHER (real-time — required for Socket.io server)
# ──────────────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ──────────────────────────────────────────────────────
# LARAVEL PASSPORT (OAuth2)
# Run: php artisan passport:install && php artisan passport:client --personal
# ──────────────────────────────────────────────────────
PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=

# ──────────────────────────────────────────────────────
# ZOOM (live meeting integration — optional)
# ──────────────────────────────────────────────────────
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# ──────────────────────────────────────────────────────
# VIMEO (video hosting — optional)
# ──────────────────────────────────────────────────────
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
VIMEO_ACCESS_TOKEN=

# ──────────────────────────────────────────────────────
# SCORM CLOUD (SCORM 1.2/2004 delivery — optional)
# ──────────────────────────────────────────────────────
SCORM_CLOUD_APP_ID=
SCORM_CLOUD_SECRET_KEY=
SCORM_CLOUD_URL=https://cloud.scorm.com

# ──────────────────────────────────────────────────────
# GOOGLE (OAuth / Drive — optional)
# ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ──────────────────────────────────────────────────────
# EMAIL SERVICE (pick one; leave others blank)
# ──────────────────────────────────────────────────────
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

RESEND_KEY=

# ──────────────────────────────────────────────────────
# CONTACT FORM
# ──────────────────────────────────────────────────────
CONTACT_MAIL_RECEIVER=support@mycompany.com
ERROR_MAIL_RECEIVER=dev@mycompany.com
