# Browser tab title
VUE_APP_NAME=My LMS

# Build environment — set to PROD for production socket.io host
ENV=production
VUE_APP_ENV=PROD

# ──────────────────────────────────────────────────────
# BACKEND API
# Full URL including /v1 suffix — used for all standard API calls
# ──────────────────────────────────────────────────────
VUE_APP_API=https://lms.mycompany.com/v1

# Backend root URL (same host, without /v1)
# Used for email verification and resend-verification flows
VUE_APP_TENANT_API=https://lms.mycompany.com

# ──────────────────────────────────────────────────────
# CENTRAL DOMAIN — leave blank in standalone mode
# (Controls whether the super-admin panel routes are loaded.
#  In standalone, super-admin routes are never loaded regardless.)
# ──────────────────────────────────────────────────────
VUE_APP_MAIN_DOMAIN=

# ──────────────────────────────────────────────────────
# REAL-TIME (Socket.io)
# The socket server runs on port 6002 of VUE_APP_API's host.
# Set VUE_APP_ENV=PROD to connect there; any other value uses localhost:6002.
# ──────────────────────────────────────────────────────
VUE_APP_SOCKET_HOST=
VUE_APP_SOCKET_PORT=

# ──────────────────────────────────────────────────────
# FILE STORAGE
# Base URL for user-uploaded assets (profile photos, attachments, etc.)
# Use your S3 bucket URL or your server's public storage URL.
# ──────────────────────────────────────────────────────
VUE_APP_ASSET_PATH=https://your-bucket.s3.ap-southeast-1.amazonaws.com

# S3 URL for SCORM package delivery
VUE_APP_AWS_S3=https://your-bucket.s3.ap-southeast-1.amazonaws.com

# ──────────────────────────────────────────────────────
# OPTIONAL INTEGRATIONS
# ──────────────────────────────────────────────────────
# TinyMCE rich-text editor API key
VUE_APP_TINYMCE_KEY=

# Zoom SDK — required only if live meeting feature is used
VUE_APP_ZOOM_SDK_KEY=
VUE_APP_ZOOM_SDK_SECRET=

# Google Analytics measurement ID (optional)
VUE_APP_GA_TRACKING_ID=
