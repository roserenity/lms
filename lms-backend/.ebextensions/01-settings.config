files:
    "/etc/php.d/custom.ini":
        mode: "000644"
        owner: root
        group: root
        content: |
            upload_max_filesize = 1024M
            post_max_size = 1024M
            max_execution_time = 1800
            max_input_time = 1800
            memory_limit = 1024M
            extension=zip.so
    "/etc/nginx/conf.d/proxy.conf":
        mode: "000644"
        owner: root
        group: root
        content: |
            client_max_body_size 1024M;

commands:
    01_install_zip_deps:
        command: "dnf -y install libzip libzip-devel"
        ignoreErrors: true
    02_install_zip_extension:
        command: "dnf -y install php8.3-zip"
        ignoreErrors: true
    03_alternative_pecl_install:
        command: "pecl install zip"
        ignoreErrors: true
        test: "[ ! -f /usr/lib64/php/modules/zip.so ]"

container_commands:
    01_restart_php_fpm:
        command: "systemctl restart php8.3-fpm"
        ignoreErrors: true
    02_reload_nginx:
        command: "systemctl restart nginx"
        ignoreErrors: true