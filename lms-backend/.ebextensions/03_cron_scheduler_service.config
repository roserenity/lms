files:
    "/etc/cron.d/cron_scheduler":
        mode: "0644"
        owner: root
        group: root
        content: |
            * * * * * root cd /var/app/current && php artisan schedule:run >> /var/log/cron_scheduler.log 2>&1

commands:
    enable_cron:
        command: "chmod 0644 /etc/cron.d/cron_scheduler && service crond restart"
